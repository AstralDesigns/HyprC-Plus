# HyprCandy Bash Configuration

export HYPRLAND_LOG_WS=1
export EDITOR=micro
export TERMINAL=kitty

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) [ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH" ;;
esac

# HyprCandy: cargo bin on PATH
case ":$PATH:" in
  *":$HOME/.cargo/bin:"*) ;;
  *) [ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH" ;;
esac

shopt -s histappend
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups

# Bash completion plugin
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# fzf key-bindings + completion
if command -v fzf > /dev/null 2>&1; then
  source <(fzf --bash 2>/dev/null) || { [ -f "$HOME/.fzf.bash" ] && . "$HOME/.fzf.bash"; }
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias update='sudo pacman -Syu'
alias install='sudo pacman -S'
alias search='pacman -Ss'
alias remove='sudo pacman -R'
alias autoremove='sudo pacman -Rs (pacman -Qtdq)'
alias c='clear'
alias h='history'
alias j='jobs -l'
alias df='df -h'
alias du='du -h'
alias mkdir='mkdir -pv'
alias wget='wget -c'
alias ff='fastfetch'

alias g='git clone --depth 1'
alias ga='git add .'
alias gc='git commit -m'
alias gl='git pull'
alias gs='git status'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias glog='git log --oneline --graph --decorate'
gp() {
    if ! grep -qF ".config/hypr" .gitignore 2>/dev/null; then
        echo ".config/hypr/hyprviz.conf" >> .gitignore
        echo ".config/hypr/monitors.conf" >> .gitignore
        git add .gitignore
        git commit -m "chore: ignore personal config dirs"
    fi
    git push
}

alias sysinfo='fastfetch'
alias weather='curl wttr.in'
alias matrix='cmatrix -a -b -r'
alias pipes='pipes.sh'
alias clock='tty-clock -s -c'
alias sea='asciiquarium'
# Start HyprCandy fastfetch
fastfetch

# Initialize Starship prompt
if command -v starship > /dev/null 2>&1; then
    eval "$(starship init bash)"
fi
