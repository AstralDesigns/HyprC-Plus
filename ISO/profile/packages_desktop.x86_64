# Limine: offline Calamares has no bootloader chooser step, so bootloader.conf
# falls back to its default (limine); the module runs limine-install inside the
# target, which only exists if baked. hook is a superset of limine-entry-tool
# (provides it); never install both - overlapping files conflict.
limine
limine-mkinitcpio-hook
# Btrfs snapshot stack (host parity). cachyos-snapper-support deliberately
# NOT baked: its post_install runs snapper create-config at install time,
# which under unpackfs bakes a build-time config. system-setup.sh recreates
# the config on first boot of the installed system instead.
snapper
snap-pac
limine-snapper-sync
grub-btrfs
