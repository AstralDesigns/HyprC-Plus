* {
    background: rgba(14, 22, 25, 0.3);
    primary: #98c7d6;
    primary-fixed: #b6e6f6;
    primary-fixed-dim: #98c7d6;
    on-primary: #001215;
    on-primary-fixed: #000000;
    on-primary-fixed-variant: #10353e;
    primary-container: #5f8b98;
    on-primary-container: #000000;
    secondary: #b1c4c9;
    secondary-fixed: #d0e3e8;
    secondary-fixed-dim: #b1c4c9;
    on-secondary: #0e1619;
    on-secondary-fixed: #010303;
    on-secondary-fixed-variant: #293539;
    secondary-container: #3e4c51;
    on-secondary-container: #ffffff;
    tertiary: #ecb38c;
    tertiary-fixed: #fbd8c2;
    tertiary-fixed-dim: #ecb38c;
    on-tertiary: #1b0d01;
    on-tertiary-fixed: #000000;
    on-tertiary-fixed-variant: #462a15;
    tertiary-container: #a97a57;
    on-tertiary-container: #000000;
    error: #f8afa6;
    on-error: #1f0001;
    error-container: #8b1112;
    on-error-container: #ffffff;
    surface: #000000;
    on-surface: #dfdfe0;
    on-surface-variant: #bac2c5;
    outline: #7f8689;
    outline-variant: #454c4d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfdfe0;
    inverse-on-surface: #1a1c1c;
    inverse-primary: #264d58;
    surface-dim: #000000;
    surface-bright: #28292a;
    surface-container-lowest: #000000;
    surface-container-low: #040505;
    surface-container: #0a0b0b;
    surface-container-high: #161718;
    surface-container-highest: #212324;
}
