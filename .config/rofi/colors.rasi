* {
    background: rgba(18, 13, 0, 0.3);
    primary: #f3b056;
    primary-fixed: #fad9b3;
    primary-fixed-dim: #f3b056;
    on-primary: #150d00;
    on-primary-fixed: #000000;
    on-primary-fixed-variant: #3f2700;
    primary-container: #5d3b00;
    on-primary-container: #ffffff;
    secondary: #d9ba86;
    secondary-fixed: #fad9a3;
    secondary-fixed-dim: #d9ba86;
    on-secondary: #120d00;
    on-secondary-fixed: #000000;
    on-secondary-fixed-variant: #3c2d10;
    secondary-container: #584522;
    on-secondary-container: #ffffff;
    tertiary: #d6bb72;
    tertiary-fixed: #f7da8d;
    tertiary-fixed-dim: #d6bb72;
    on-tertiary: #110d00;
    on-tertiary-fixed: #000000;
    on-tertiary-fixed-variant: #352901;
    tertiary-container: #534311;
    on-tertiary-container: #ffffff;
    error: #f8afa6;
    on-error: #1f0001;
    error-container: #8b1112;
    on-error-container: #ffffff;
    surface: #000000;
    on-surface: #efdbc8;
    on-surface-variant: #cfbdaa;
    outline: #928272;
    outline-variant: #53483b;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #efdbc8;
    inverse-on-surface: #1f1811;
    inverse-primary: #5c3a00;
    surface-dim: #000000;
    surface-bright: #2e261c;
    surface-container-lowest: #000000;
    surface-container-low: #030201;
    surface-container: #0c0905;
    surface-container-high: #1a150e;
    surface-container-highest: #272017;
}
