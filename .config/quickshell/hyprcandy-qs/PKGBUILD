# Maintainer: AstralDesigns <ianomiruka@gmail.com>
#
# HyprCandy+ patched build of the noctalia Quickshell fork, packaged standalone
# as hyprcandy-qs (a drop-in that replaces the repo noctalia-qs / quickshell).
#
# WHY THIS EXISTS
#   Upstream noctalia-qs constructs QGuiApplication/QApplication with argc = 0
#   (src/launch/launch.cpp: "auto qArgC = 0;"). QtWebEngine is Chromium, which
#   reads argv[0] during early startup and aborts / fails to render when argc is
#   0, so the stock repo/CachyOS package cannot host an embedded WebEngineView.
#   We maintain a fork (github.com/AstralDesigns/noctalia-qs, branch "hyprcandy",
#   tag v0.0.12-hc1) that carries the one-line argc=1 fix as a real commit, so
#   this build simply compiles that pinned tag -- no fragile string-patching at
#   build time. qt6-webengine is a runtime dep so the QtWebEngine QML plugin
#   (QtWebEngine + libQt6WebEngineCore) exists; the plugin loads at runtime, so
#   there is no WebEngine build flag to set. Required by the HyprCandy+ launcher's
#   embedded browser tab.
#
#   The crash handler is disabled (-DCRASH_HANDLER=OFF) to keep the automated
#   build lean: it would otherwise require cpptrace/libdwarf/libunwind (AUR /
#   exotic) which complicates a one-command install. Functionally the bar/launcher
#   are unaffected; the only loss is the auto-restart-on-crash watchdog.
#
#   Shipped under its own name (hyprcandy-qs) so it no longer trips the
#   "local newer than repo noctalia-qs" warning during -Syu. provides/conflicts
#   still list noctalia-qs + quickshell so it stays a drop-in replacement and
#   satisfies anything that depends on either.

_pkg=noctalia-qs
pkgname=hyprcandy-qs
pkgver=0.0.12
pkgrel=1
epoch=1
pkgdesc="Quickshell (noctalia fork) rebuilt with QtWebEngine support for the HyprCandy+ launcher"
arch=('x86_64')
url="https://github.com/AstralDesigns/noctalia-qs"
license=('custom')

depends=(
    'gcc-libs' 'glibc' 'hicolor-icon-theme' 'jemalloc' 'libdrm' 'libglvnd'
    'libpipewire' 'libxcb' 'mesa' 'pam' 'polkit'
    'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-webengine'
    'wayland'
)
makedepends=(
    'git' 'cmake' 'ninja' 'pkgconf' 'python' 'cli11'
    'qt6-shadertools' 'spirv-tools' 'glslang' 'vulkan-headers'
)
provides=('quickshell' 'quickshell-git' 'noctalia-qs')
conflicts=('quickshell' 'quickshell-git' 'noctalia-qs')
# !lto: CachyOS's makepkg.conf enables full LTO (-flto=auto) whose link-time
# relink of this large statically-linked Qt binary takes ~15+ min on low-core
# CPUs and buys nothing for a QML shell. Disabling it cuts the build to minutes.
options=('!lto' '!debug' 'strip')

# Pinned to our fork's patched tag (argc=1 committed upstream in the fork).
_srctag="v0.0.12-hc1"
source=("git+${url}.git#tag=${_srctag}")
sha256sums=('SKIP')

_distributor="HyprCandy+ (hyprcandy-qs: noctalia fork + QtWebEngine)"

prepare() {
    cd "$_pkg"
    # Qt 6.12 + GCC 16 combined-AUTOMOC compat shim (toolchain-only, not a source defect).
    # Several quickshell modules hold two mutually forward-declared QObjects that expose each
    # other as a pointer Q_PROPERTY (e.g. HyprlandMonitor<->HyprlandWorkspace, I3Monitor<->
    # I3Workspace, and the pipewire PwNodeIface/PwLinkIface<->PwNodePeakMonitor/PwAudioSpectrum
    # pair). CMake's AUTOMOC compiles every header's moc into one shared mocs_compilation.cpp
    # TU; there GCC 16 caches the earlier "incomplete in a SFINAE context" verdict from the
    # forward-decl uses, so Qt's unconditional static_assert(TypeIsCompleteOrVoid<Self>) then
    # hard-fails in each class's OWN moc: "error: Meta Types must be fully defined". On the
    # Qt 6.11 / GCC 15 toolchain this was merely the -Wsfinae-incomplete warning, so the fork
    # built fine. Self-including the moc in the matching .cpp pulls it out of the combined TU
    # (each such .cpp already #includes the peer header, so the type is complete there) and the
    # leftover pointer-to-incomplete uses in the remaining mocs are legal, so the assert passes.
    # Verified: hyprland-ipc, i3-ipc and service-pipewire then all compile+link.
    local tu stem
    for tu in \
        src/wayland/hyprland/ipc/monitor.cpp \
        src/wayland/hyprland/ipc/workspace.cpp \
        src/x11/i3/ipc/monitor.cpp \
        src/x11/i3/ipc/workspace.cpp \
        src/services/pipewire/qml.cpp ; do
        [ -f "$tu" ] || continue
        stem="${tu##*/}"; stem="${stem%.cpp}"
        grep -q "moc_${stem}\.cpp" "$tu" || printf '\n#include "moc_%s.cpp"\n' "$stem" >> "$tu"
    done
}

build() {
    cd "$_pkg"
    # BUILD.md: a UTF-8 locale keeps real diagnostics from being buried by Qt warnings.
    export LC_ALL=C.UTF-8 LANG=C.UTF-8
    # Belt-and-suspenders: strip any LTO that a distro makepkg.conf injected into
    # the flags (options=(!lto) alone doesn't always remove a literal -flto).
    export CXXFLAGS="${CXXFLAGS/-flto=auto/} ${CXXFLAGS/-flto/}"
    export CFLAGS="${CFLAGS/-flto=auto/} ${CFLAGS/-flto/}"
    export LDFLAGS="${LDFLAGS/-flto=auto/} ${LDFLAGS/-flto/}"
    # Portable binary for the prebuilt release asset: CachyOS makepkg.conf injects
    # -march=native (or an x86-64-vN level) that ties the .pkg.tar.zst to the build
    # box's CPU. Since this package is downloaded and installed directly on every
    # user's machine, neutralize any arch/tuning flag down to the widely-safe
    # x86-64-v2 baseline (SSE4.2 + POPCNT, ~2009+) so it never SIGILLs elsewhere.
    CFLAGS=$(printf '%s' "$CFLAGS"   | sed -E 's/-march=[^[:space:]]+/-march=x86-64-v2/g; s/-mtune=[^[:space:]]+/-mtune=generic/g')
    CXXFLAGS=$(printf '%s' "$CXXFLAGS" | sed -E 's/-march=[^[:space:]]+/-march=x86-64-v2/g; s/-mtune=[^[:space:]]+/-mtune=generic/g')
    export CFLAGS CXXFLAGS
    cmake -GNinja -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DDISTRIBUTOR="$_distributor" \
        -DCRASH_HANDLER=OFF
    cmake --build build
}

package() {
    cd "$_pkg"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
    [ -f LICENSE-GPL ] && install -Dm644 LICENSE-GPL "$pkgdir/usr/share/licenses/$pkgname/LICENSE-GPL" 2>/dev/null
    return 0
}
