    },
    "Qwen2.5-Coder-0.5B-Instruct": {
      "repo": "bartowski/Qwen2.5-Coder-0.5B-Instruct-GGUF",
      "file": "Qwen2.5-Coder-0.5B-Instruct-Q4_K_M.gguf"
    }
  },
  "allowScripts": {
    "esbuild": true
  }
