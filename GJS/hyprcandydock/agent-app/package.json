{
  "name": "hyprcandy-agent-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "llama:build": "bash ./build-llama-server.sh",
    "llama:pull:1.5b": "node ./scripts/llama-pull.cjs Qwen2.5-Coder-1.5B-Instruct",
    "llama:pull:0.5b": "node ./scripts/llama-pull.cjs Qwen2.5-Coder-0.5B-Instruct",
    "llama:test": "node ./scripts/llama-chat-test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.447.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.6.2",
    "vite": "^7.3.0"
  },
  "nativeDependencies": {
    "llama.cpp": {
      "repository": "https://github.com/ggml-org/llama.cpp.git",
      "tag": "v0.4.0",
      "binary": "llama-server",
      "buildSystem": "cmake",
      "archInstall": "HYPRCANDY_LLAMA_BACKEND=vulkan paru/yay -S --needed llama.cpp-vulkan-bin",
